{
  "expo": {
    "name": "Rimind",
    "slug": "rimind",
    "version": "2.0.0",
    "orientation": "portrait",
    "scheme": "rimind",
    "icon": "./assets/icons/icon-light.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F8FAFC",
    "primaryColor": "#F97316",
    "assetBundlePatterns": ["**/*"],
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#F97316",
          "defaultChannel": "birthday-reminders"
        }
      ],
      "expo-localization",
      "expo-system-ui",
      "expo-font",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.diegoseg.rimind",
      "userInterfaceStyle": "automatic",
      "icon": {
        "light": "./assets/icons/ios-icon-light.png",
        "dark": "./assets/icons/ios-icon-dark.png",
        "tinted": "./assets/icons/ios-icon-tinted.png"
      }
    },
    "android": {
      "package": "com.diegoseg.rimind",
      "versionCode": 1,
      "userInterfaceStyle": "automatic",
      "backgroundColor": "#15212B",
      "adaptiveIcon": {
        "backgroundColor": "#202E3C",
        "foregroundImage": "./assets/icons/android-icon-foreground.png",
        "monochromeImage": "./assets/icons/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/icons/favicon.png",
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "7c5496ed-61f0-4b09-aec3-c244d515583c"
      }
    }
  }
}
