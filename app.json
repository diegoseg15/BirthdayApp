{
  "expo": {
    "name": "BirthdayApp",
    "slug": "birthday-app",
    "version": "2.0.0",
    "orientation": "portrait",
    "scheme": "birthdayapp",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": ["**/*"],
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#F97316",
          "defaultChannel": "birthday-reminders"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.diegoseg.birthdayapp"
    },
    "android": {
      "package": "com.diegoseg.birthdayapp",
      "adaptiveIcon": {
        "backgroundColor": "#15212B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    }
  }
}
